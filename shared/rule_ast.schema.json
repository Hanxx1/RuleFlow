{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuleFlow Rule AST v2",
  "$defs": {
    "evidence": {
      "type": "string",
      "pattern": "^block:[A-Za-z0-9._:-]+$"
    },
    "field": {
      "type": "string",
      "enum": [
        "profile.student_type",
        "profile.enrollment_year",
        "profile.graduation_year",
        "profile.college",
        "profile.major",
        "profile.class_name",
        "profile.role",
        "profile.rank_percent",
        "profile.team_size",
        "profile.certificate_level",
        "profile.moral_bonus_items",
        "profile.moral_score",
        "profile.advisor_count",
        "profile.participation_count",
        "profile.disciplinary_status",
        "profile.coursework_status",
        "profile.fitness_status",
        "profile.school"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "enum": [
            "and",
            "or"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "args"
      ],
      "properties": {
        "op": {
          "const": "not"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "field"
      ],
      "properties": {
        "op": {
          "enum": [
            "eq",
            "in",
            "gte",
            "lte",
            "exists",
            "contains",
            "before",
            "after"
          ]
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "value": {},
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  ]
}
