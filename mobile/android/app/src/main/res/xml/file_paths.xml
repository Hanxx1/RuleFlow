<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capacitor WebView camera input writes to getExternalFilesDir(Pictures). -->
    <external-files-path name="camera_pictures" path="Pictures/" />
    <!-- Outbound exports only; grant individual URIs temporary read access at send time. -->
    <cache-path name="exports" path="exports/" />
</paths>
